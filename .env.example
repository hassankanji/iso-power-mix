# Copy to .env and fill in your keys. .env is gitignored - never commit real credentials.
# See README.md "API Registration" section for exact steps to obtain each of these.

# PJM Data Miner 2 / API Hub - https://apiportal.pjm.com/
PJM_SUBSCRIPTION_KEY=

# MISO Data Exchange (LGI API) - https://data-exchange.misoenergy.org/
MISO_API_KEY=

# ISO-NE Web Services API (ISO Express account) - https://www.iso-ne.com/
ISONE_USERNAME=
ISONE_PASSWORD=

# EIA open-data API - https://www.eia.gov/opendata/ (free, instant)
# Powers automatic gap-filling, the US48 national overlay, and reconciliation.
EIA_API_KEY=
